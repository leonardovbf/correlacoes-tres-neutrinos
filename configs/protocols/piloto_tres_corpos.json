{
  "schema_version": 1,
  "name": "piloto-tres-corpos-v1",
  "description": "Piloto local para validar registro e reprodução de Kzzz; não é coleta oficial nem benchmark publicado.",
  "steps": [
    {
      "id": "referencia",
      "action": "classical",
      "request": {
        "config": {
          "n": 4, "mu": 1.0, "theta": 0.2,
          "omega_values": [0.7, 0.9, 1.1, 1.3],
          "flavors": [0, 0, 1, 1], "t_max": 2.0, "points": 21, "seed": 42
        },
        "trajectories": 256,
        "substeps": 4
      }
    },
    {
      "id": "circuito_local",
      "action": "quantum",
      "run_from": "referencia",
      "request": {"steps": 2, "shots": 1024, "readout_error": 0.0}
    },
    {
      "id": "incerteza_psa_trio_012",
      "action": "interval",
      "run_from": "referencia",
      "request": {"method": "psa", "kind": "c3", "index": 0, "repetitions": 200, "seed": 1234}
    },
    {
      "id": "incerteza_circuito_trio_012",
      "action": "interval",
      "run_from": "referencia",
      "request": {"method": "measured", "kind": "c3", "index": 0, "repetitions": 200, "seed": 1234}
    },
    {"id": "convergencia", "action": "convergence", "run_from": "referencia"}
  ]
}
