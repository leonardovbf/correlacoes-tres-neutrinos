# Copie para .env na raiz e preencha com sua chave da IBM Quantum Platform.
# A chave é lida apenas pelo backend Python e não deve ser colocada no frontend.
IBM_QUANTUM_API_KEY=
# Opcional, mas recomendado: CRN da sua instância IBM Quantum.
IBM_QUANTUM_INSTANCE=
# Opcional: dispositivo sugerido na interface.
IBM_QUANTUM_BACKEND=
